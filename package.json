{
  "name": "card-game-template",
  "private": true,
  "version": "0.1.0",
  "description": "A template for server-authoritative, multiplayer card games: pure rules engine, rooms with bots, React table.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @cardgame/web dev",
    "build": "pnpm --filter @cardgame/web build",
    "start": "pnpm --filter @cardgame/server start",
    "check": "pnpm -r --parallel check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @cardgame/web test:e2e",
    "sim": "tsx scripts/simulate.ts",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint:boundaries && pnpm check && pnpm test && pnpm build",
    "rename": "node scripts/rename.mjs",
    "new:expansion": "node scripts/new-expansion.mjs",
    "docker:build": "docker build -t card-game-template:latest ."
  },
  "devDependencies": {
    "@cardgame/engine": "workspace:*",
    "@cardgame/game": "workspace:*",
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vitest": "^5.0.5"
  }
}
