# Domain served by compose.yaml (Caddy gets its HTTPS certificate).
DOMAIN=cards.example.com
# Public origin of the app (required in production, exact HTTPS origin).
PUBLIC_ORIGIN=https://cards.example.com
# Set to 1 only behind a private reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=
# SQLite file; ":memory:" keeps nothing between restarts.
DB_PATH=data/game.sqlite
PORT=3000
# Webhook told about server errors (ntfy topic, Discord or Slack webhook); empty sends nothing.
# Keep it secret: the URL is the topic's password. See docs/operations.md.
ALERT_WEBHOOK_URL=
