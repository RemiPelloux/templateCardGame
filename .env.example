# Read by `docker compose` (compose.yaml). Copy to .env and fill in. Without Docker, set the
# same variables in your environment; docs/deployment.md lists every one.

# Domain Caddy serves and obtains the HTTPS certificate for; the app's PUBLIC_ORIGIN is
# https://$DOMAIN.
DOMAIN=cards.example.com

# Secret behind each daily challenge's deal, 16 characters or more: openssl rand -hex 32
DAILY_SALT=

# Time zone whose midnight starts a new daily challenge.
DAILY_TIME_ZONE=Europe/Paris

# Optional: where server errors are announced (ntfy topic, Discord or Slack webhook).
# Keep it secret: anyone with the URL can post there. See docs/operations.md.
ALERT_WEBHOOK_URL=
